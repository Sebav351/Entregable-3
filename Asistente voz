def procesar_mensaje(topic, msg):
    orden = msg.decode().strip()
    print("Mensaje recibido de DeepSeek:", orden)

    if orden == "LED_ON":
        led.value(1)
        print("LED Encendido!")
    elif orden == "LED_OFF":
        led.value(0)
        print("LED Apagado!")


TOPIC = "lab_micro_deepseek/led_unico"
client = MiniMQTT("wokwi_single_led_node", "broker.hivemq.com")
client.set_callback(procesar_mensaje)

if client.connect():
    print("Conectado a MQTT Broker!")
    client.subscribe(TOPIC)
    print("Escuchando en:", TOPIC)


while True:
    client.check_msg()
    time.sleep(0.05)
